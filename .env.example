# Copy to .env and fill in, or set these in your Vercel project settings.
# Nothing here is needed to run locally without sign-in: `node server.js` works
# with none of it set.

# --- Database (hosted deployments only) ------------------------------------
# Vercel sets this for you when you add a Neon Postgres database to the project.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Google sign-in --------------------------------------------------------
# From console.cloud.google.com → APIs & Services → Credentials.
# The authorized redirect URI must be https://YOUR-DOMAIN/api/auth/callback
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Any long random string. `openssl rand -hex 32` is a good source.
# Changing it signs everyone out immediately.
# SESSION_SECRET=

# Who may sign in. Set at least one; both may be set and they add together.
# With neither, nobody gets in — the safe direction to fail.
# ALLOWED_DOMAINS=primetimestubs.com
# ALLOWED_EMAILS=brian@primetimestubs.com,someone@example.com

# --- Local server options --------------------------------------------------
# PORT=4173
# HOST=127.0.0.1
# STORE_FILE=data/store.json
# INBOX_DIR=inbox
